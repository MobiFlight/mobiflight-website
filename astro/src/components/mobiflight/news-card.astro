---
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/starwind/card"
import { Button } from "@/components/starwind/button"

export interface NewsItem {
  date: string
  title: string
  content: string[]
  media?: {
    type: string
    src: string
    alt: string
  }
  tags: string[]
  action?: {
    title: string
    url: string
  }
}

interface Props {
  item: NewsItem,
  baseUrl?: string
}

const { item, baseUrl } = Astro.props
---

<Card>
  <CardHeader>
    <p class="text-sm text-muted-foreground">{item.date}</p>
    <CardTitle class="text-lg">{item.title}</CardTitle>
  </CardHeader>
  <CardContent class="flex flex-col gap-4">
    {item.media && <img class="w-full object-cover h-72" src={`${baseUrl ?? ""}${item.media.src}`} alt={item.media.alt} />}
    <CardDescription class="flex flex-col gap-2 min-h-32">
      {item.content.map((line) => <p>{line}</p>)}
    </CardDescription>
    {item.action && (
      <Button href={item.action.url} variant="primary">
        {item.action.title}
      </Button>
    )}
  </CardContent>
</Card>
