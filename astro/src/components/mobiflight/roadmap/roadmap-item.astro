---
import Button from "@/components/starwind/button/Button.astro"
import Vote from "@/components/mobiflight/islands/vote.tsx"
import IconGithub from "@/components/mobiflight/icons/icon-github.astro"
import Badge from "@/components/starwind/badge"
import IconCheckCircle from "@/components/mobiflight/icons/icon-check-circle.astro"
import IconPercentage30 from "@/components/mobiflight/icons/icon-percentage-30.astro"
import IconCircleDashed from "@/components/mobiflight/icons/icon-circle-dashed.astro"

export type RoadmapItemStatus = "started" | "completed"
export type RoadmapItemFeature = {
  description: string
  status?: RoadmapItemStatus
}

export interface RoadmapItem {
  id: string
  title: string
  problem: string
  outcome: string
  features: RoadmapItemFeature[]
  issues: number[]
  votes?: number
  status?: RoadmapItemStatus
}

interface Props {
  item: RoadmapItem
}

const badgeStatusVariants = {
  "started": "bg-sky-600 text-white",
  "completed": "bg-emerald-600 text-white"
} as Record<RoadmapItemStatus, string>

const iconStatusVariants = {
  "started": "text-sky-600",
  "completed": "text-emerald-600"
} as Record<RoadmapItemStatus, string>

const { item } = Astro.props
---

<div class="flex-row flex justify-between items-center mb-2">
  <h2 class="text-3xl font-bold">
    {item.title}
  </h2>
  {item.status && <Badge class={badgeStatusVariants[item.status]}>{item.status}</Badge>}
</div>
<h2 class="text-xl font-semibold">The problem</h2>
<p>{item.problem}</p>
<h2 class="text-xl font-semibold">The solution</h2>
<div class="flex-1 flex flex-col gap-2">
  <p>{item.outcome}</p>
</div>
{
  item.features.length > 0 && (
    <>
      <h3 class="text-xl font-bold">Key Features</h3>
      <ul class="list-disc list-inside">
        {item.features.map((feature) => (
          <li>
            <span class="inline-flex items-center gap-2">
              {feature.description}{" "}
              {feature.status == "completed" && (
                <span title="Completed" class={iconStatusVariants[feature.status]}>
                  <IconCheckCircle />
                </span>
              )}
              {feature.status == "started" && (
                <span title="Started" class={iconStatusVariants[feature.status]}>
                  <IconPercentage30 /> 
                </span>
              )}
              {item.status == "started" && feature.status == undefined && (
                <span title="Not started">
                  <IconCircleDashed /> 
                </span>
              )}
            </span>
          </li>
        ))}
      </ul>
    </>
  )
}

<div class="flex flex-row gap-2 mt-4 justify-between items-center">
  <div class="flex flex-row gap-2 items-center">
    <span class="sr-only">Votes</span>
    <Vote voteCount={item.votes ?? 0} voteItemId={item.id} client:load />
  </div>
  {
    item.issues.length > 0 && (
      <div class="flex flex-row gap-2 items-center">
        <h3 title="GitHub tracker">
          <IconGithub />
        </h3>
        <ul class="flex flex-row flex-wrap gap-2">
          {item.issues.map((issue) => (
            <li>
              <Button
                variant="outline"
                class="rounded-full h-6"
                size="sm"
                href={`https://github.com/MobiFlight/MobiFlight-Connector/issues/${issue}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                #{issue}
              </Button>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</div>
