---
import Container from "@/components/mobiflight/container.astro"
import NewsCard from "@/components/mobiflight/news/news-card.astro"
import news from "@/../public/feed/en/feed.json" 
import type { NewsItem } from "@/components/mobiflight/news/news-card.astro"
---

<!-- News & Updates -->
<Container>
  <section class="py-8 border-t">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
      <div>
        <h2 class="text-3xl font-bold mb-2">News & Updates</h2>
        <p class="text-muted-foreground">
          Latest announcements, releases, and community highlights.
        </p>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {news.community.map((entry: NewsItem) => <NewsCard item={entry} baseUrl="/feed/" />)}
    </div>
  </section>
</Container>

<script>
  import { isCurrentNewsItem } from "@/lib/news"

  // The page is built ahead of time, so check again with the visitor's date:
  // items are hidden once they expire and shown once their date has come.
  document.querySelectorAll<HTMLElement>("[data-news-date]").forEach((card) => {
    card.hidden = !isCurrentNewsItem({
      date: card.dataset.newsDate ?? "",
      expires: card.dataset.newsExpires,
    })
  })
</script>
